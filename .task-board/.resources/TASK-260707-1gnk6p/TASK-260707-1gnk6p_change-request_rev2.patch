diff --git a/tools/agents-infra/bootstrap_lldb_mcp_test.go b/tools/agents-infra/bootstrap_lldb_mcp_test.go
new file mode 100644
index 0000000..681c7f4
--- /dev/null
+++ b/tools/agents-infra/bootstrap_lldb_mcp_test.go
@@ -0,0 +1,287 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+type bootstrapLLDBHarness struct {
+	root       string
+	home       string
+	mockBin    string
+	brewPrefix string
+	brewLog    string
+	binDir     string
+	configDir  string
+}
+
+func newBootstrapLLDBHarness(t *testing.T) *bootstrapLLDBHarness {
+	t.Helper()
+	root := sourceRepoRoot(t)
+	sandbox := t.TempDir()
+	harness := &bootstrapLLDBHarness{
+		root:       root,
+		home:       filepath.Join(sandbox, "home"),
+		mockBin:    filepath.Join(sandbox, "mock-bin"),
+		brewPrefix: filepath.Join(sandbox, "homebrew"),
+		brewLog:    filepath.Join(sandbox, "brew.log"),
+		binDir:     filepath.Join(sandbox, "installed-bin"),
+		configDir:  filepath.Join(sandbox, "config"),
+	}
+	for _, directory := range []string{harness.home, harness.mockBin, filepath.Join(harness.brewPrefix, "bin")} {
+		if err := os.MkdirAll(directory, 0o755); err != nil {
+			t.Fatalf("MkdirAll(%s): %v", directory, err)
+		}
+	}
+
+	writeBootstrapExecutable(t, filepath.Join(harness.mockBin, "uname"), `#!/bin/sh
+case "${1:-}" in
+  -s) printf 'Darwin\n' ;;
+  -m) printf 'arm64\n' ;;
+  *) printf 'Darwin\n' ;;
+esac
+`)
+	writeBootstrapExecutable(t, filepath.Join(harness.mockBin, "go"), `#!/bin/sh
+set -eu
+if [ "${1:-}" = "version" ]; then
+  printf 'go version go1.25.0 darwin/arm64\n'
+  exit 0
+fi
+output=''
+previous=''
+for argument in "$@"; do
+  if [ "$previous" = "-o" ]; then
+    output="$argument"
+    break
+  fi
+  previous="$argument"
+done
+if [ -z "$output" ]; then
+  printf 'fake go: missing -o output\n' >&2
+  exit 64
+fi
+mkdir -p "$(dirname "$output")"
+printf '#!/bin/sh\nexit 0\n' > "$output"
+chmod +x "$output"
+`)
+
+	return harness
+}
+
+func (h *bootstrapLLDBHarness) installFakeBrew(t *testing.T) {
+	t.Helper()
+	writeBootstrapExecutable(t, filepath.Join(h.mockBin, "brew"), `#!/bin/sh
+set -eu
+case "${1:-}" in
+  --prefix)
+    if [ "${2:-}" = "llvm" ]; then
+      printf '%s\n' "$TEST_BREW_PREFIX/opt/llvm"
+    else
+      printf '%s\n' "$TEST_BREW_PREFIX"
+    fi
+    ;;
+  install)
+    if [ "${2:-}" != "llvm" ]; then
+      printf 'fake brew: unexpected formula %s\n' "${2:-}" >&2
+      exit 64
+    fi
+    printf 'install llvm\n' >> "$TEST_BREW_LOG"
+    mkdir -p "$TEST_BREW_PREFIX/opt/llvm/bin"
+    printf '#!/bin/sh\nexit 0\n' > "$TEST_BREW_PREFIX/opt/llvm/bin/lldb-mcp"
+    printf '#!/bin/sh\nexit 0\n' > "$TEST_BREW_PREFIX/opt/llvm/bin/lldb"
+    chmod +x "$TEST_BREW_PREFIX/opt/llvm/bin/lldb-mcp" "$TEST_BREW_PREFIX/opt/llvm/bin/lldb"
+    ;;
+  *)
+    printf 'fake brew: unexpected arguments: %s\n' "$*" >&2
+    exit 64
+    ;;
+esac
+`)
+}
+
+func (h *bootstrapLLDBHarness) seedFakeLLVM(t *testing.T) {
+	t.Helper()
+	llvmBin := filepath.Join(h.brewPrefix, "opt", "llvm", "bin")
+	if err := os.MkdirAll(llvmBin, 0o755); err != nil {
+		t.Fatalf("MkdirAll(%s): %v", llvmBin, err)
+	}
+	for _, name := range []string{"lldb-mcp", "lldb"} {
+		writeBootstrapExecutable(t, filepath.Join(llvmBin, name), "#!/bin/sh\nexit 0\n")
+	}
+}
+
+func (h *bootstrapLLDBHarness) run(t *testing.T) (string, error) {
+	t.Helper()
+	command := exec.Command(filepath.Join(h.root, "setup.sh"))
+	command.Dir = h.root
+	command.Env = []string{
+		"PATH=" + filepath.Join(h.brewPrefix, "bin") + ":" + h.mockBin + ":/usr/bin:/bin",
+		"HOME=" + h.home,
+		"BIN_DIR=" + h.binDir,
+		"AGENTS_INFRA_CONFIG_DIR=" + h.configDir,
+		"AGENTS_INFRA_SKIP_LLDB_MCP=",
+		"TEST_BREW_PREFIX=" + h.brewPrefix,
+		"TEST_BREW_LOG=" + h.brewLog,
+		"LANG=C",
+	}
+	output, err := command.CombinedOutput()
+	return string(output), err
+}
+
+func writeBootstrapExecutable(t *testing.T, path, body string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(body), 0o755); err != nil {
+		t.Fatalf("WriteFile(%s): %v", path, err)
+	}
+}
+
+func TestBootstrapSetupRefusesMissingHomebrewAndLLDBMCP(t *testing.T) {
+	harness := newBootstrapLLDBHarness(t)
+
+	output, err := harness.run(t)
+	if err == nil {
+		t.Fatalf("./setup.sh accepted a macOS host with neither Homebrew nor lldb-mcp:\n%s", output)
+	}
+	for _, want := range []string{"Homebrew", "lldb-mcp", "brew install llvm"} {
+		if !strings.Contains(output, want) {
+			t.Fatalf("./setup.sh refusal missing %q:\n%s", want, output)
+		}
+	}
+	if strings.Contains(output, "=== Done ===") {
+		t.Fatalf("./setup.sh advertised success after refusing missing LLDB prerequisites:\n%s", output)
+	}
+}
+
+func TestBootstrapSetupAcceptsExistingLLDBMCPWithoutHomebrew(t *testing.T) {
+	harness := newBootstrapLLDBHarness(t)
+	existing := filepath.Join(harness.mockBin, "lldb-mcp")
+	writeBootstrapExecutable(t, existing, "#!/bin/sh\nexit 0\n")
+
+	output, err := harness.run(t)
+	if err != nil {
+		t.Fatalf("./setup.sh rejected existing lldb-mcp without Homebrew: %v\n%s", err, output)
+	}
+	if !strings.Contains(output, "lldb-mcp already installed: "+existing) {
