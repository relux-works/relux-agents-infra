+	if err != nil {
+		t.Fatalf("Stat(%s) after setup: %v", wrapper, err)
+	}
+	if os.SameFile(forgedInfo, repairedInfo) {
+		t.Fatalf("./setup.sh accepted marker-only managed wrapper with the wrong helper target")
+	}
+
+	brewLog, err := os.ReadFile(harness.brewLog)
+	if err != nil {
+		t.Fatalf("ReadFile(%s): %v", harness.brewLog, err)
+	}
+	if got := strings.Count(string(brewLog), "install llvm\n"); got != 1 {
+		t.Fatalf("brew install llvm calls while repairing forged wrapper = %d, want 1; log:\n%s", got, brewLog)
+	}
+	helpTarget := filepath.Join(harness.brewPrefix, "opt", "llvm", "bin", "lldb-mcp")
+	repaired, err := os.ReadFile(wrapper)
