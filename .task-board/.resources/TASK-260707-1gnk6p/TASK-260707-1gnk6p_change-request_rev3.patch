diff --git a/tools/agents-infra/setup_lldb_mcp_test.go b/tools/agents-infra/setup_lldb_mcp_test.go
new file mode 100644
index 0000000..78cfe47
--- /dev/null
+++ b/tools/agents-infra/setup_lldb_mcp_test.go
@@ -0,0 +1,251 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+const managedLLDBMCPMarker = "agents-infra managed lldb-mcp wrapper"
+
+type lldbMCPSetupHarness struct {
+	home       string
+	binDir     string
+	configDir  string
+	fakeBin    string
+	brewPrefix string
+	llvmPrefix string
+	brewLog    string
+}
+
+func newLLDBMCPSetupHarness(t *testing.T, withBrew bool) lldbMCPSetupHarness {
+	t.Helper()
+	root := t.TempDir()
+	harness := lldbMCPSetupHarness{
+		home:       filepath.Join(root, "home"),
+		binDir:     filepath.Join(root, "installed-bin"),
+		configDir:  filepath.Join(root, "config"),
+		fakeBin:    filepath.Join(root, "fake-bin"),
+		brewPrefix: filepath.Join(root, "homebrew"),
+		llvmPrefix: filepath.Join(root, "homebrew", "opt", "llvm"),
+		brewLog:    filepath.Join(root, "brew-install.log"),
+	}
+	for _, path := range []string{harness.home, harness.binDir, harness.configDir, harness.fakeBin} {
+		if err := os.MkdirAll(path, 0o755); err != nil {
+			t.Fatalf("MkdirAll(%s): %v", path, err)
+		}
+	}
+	writeExecutable(t, filepath.Join(harness.fakeBin, "go"), `#!/bin/sh
+set -eu
+if [ "${1:-}" = "version" ]; then
+  echo 'go version go-test darwin/arm64'
+  exit 0
+fi
+output=''
+while [ "$#" -gt 0 ]; do
+  if [ "$1" = '-o' ]; then
+    output="$2"
+    shift 2
+    continue
+  fi
+  shift
+done
+[ -n "$output" ]
+mkdir -p "$(dirname "$output")"
+printf '%s\n' '#!/bin/sh' 'exit 0' > "$output"
+chmod +x "$output"
+`)
+	if withBrew {
+		if err := os.MkdirAll(filepath.Join(harness.brewPrefix, "bin"), 0o755); err != nil {
+			t.Fatalf("MkdirAll(Homebrew bin): %v", err)
+		}
+		writeExecutable(t, filepath.Join(harness.fakeBin, "brew"), `#!/bin/sh
+set -eu
+case "${1:-}:${2:-}" in
+  --prefix:)
+    printf '%s\n' "$FAKE_BREW_PREFIX"
+    ;;
+  --prefix:llvm)
+    [ -e "$FAKE_LLVM_PREFIX/.installed" ] || exit 1
+    printf '%s\n' "$FAKE_LLVM_PREFIX"
+    ;;
+  install:llvm)
+    printf '%s\n' llvm >> "$FAKE_BREW_LOG"
+    mkdir -p "$FAKE_LLVM_PREFIX"
+    : > "$FAKE_LLVM_PREFIX/.installed"
+    if [ "${FAKE_BREW_CREATE_LLVM:-1}" = 1 ]; then
+      mkdir -p "$FAKE_LLVM_PREFIX/bin"
+      printf '%s\n' '#!/bin/sh' 'printf "delegated"' 'for arg in "$@"; do printf "|%s" "$arg"; done' 'printf "\\n"' > "$FAKE_LLVM_PREFIX/bin/lldb-mcp"
+      printf '%s\n' '#!/bin/sh' 'exit 0' > "$FAKE_LLVM_PREFIX/bin/lldb"
+      chmod +x "$FAKE_LLVM_PREFIX/bin/lldb-mcp" "$FAKE_LLVM_PREFIX/bin/lldb"
+    fi
+    ;;
+  *)
+    echo "unexpected brew invocation: $*" >&2
+    exit 64
+    ;;
+esac
+`)
+	}
+	return harness
+}
+
+func (h lldbMCPSetupHarness) run(t *testing.T, extraEnv ...string) (string, error) {
+	t.Helper()
+	setup := filepath.Join(sourceRepoRoot(t), "setup.sh")
+	command := exec.Command("/bin/zsh", setup, "--bin-dir", h.binDir)
+	command.Env = append(os.Environ(),
+		"HOME="+h.home,
+		"AGENTS_INFRA_CONFIG_DIR="+h.configDir,
+		"AGENTS_INFRA_SKIP_LLDB_MCP=0",
+		"FAKE_BREW_PREFIX="+h.brewPrefix,
+		"FAKE_LLVM_PREFIX="+h.llvmPrefix,
+		"FAKE_BREW_LOG="+h.brewLog,
+		"PATH="+strings.Join([]string{h.fakeBin, filepath.Join(h.brewPrefix, "bin"), "/usr/bin", "/bin"}, string(os.PathListSeparator)),
+	)
+	command.Env = append(command.Env, extraEnv...)
+	output, err := command.CombinedOutput()
+	return string(output), err
+}
+
+func writeExecutable(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o755); err != nil {
+		t.Fatalf("WriteFile(%s): %v", path, err)
+	}
+}
+
+func fileInode(t *testing.T, path string) uint64 {
+	t.Helper()
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("Stat(%s): %v", path, err)
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		t.Fatalf("Stat(%s) returned %T, want *syscall.Stat_t", path, info.Sys())
+	}
+	return stat.Ino
+}
+
+func brewInstallCount(t *testing.T, path string) int {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return 0
+	}
+	if err != nil {
+		t.Fatalf("ReadFile(%s): %v", path, err)
+	}
+	return len(strings.Fields(string(data)))
+}
+
+func assertWrapperDelegates(t *testing.T, wrapper string) {
+	t.Helper()
+	command := exec.Command(wrapper, "--socket", "auto")
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("managed wrapper delegation failed: %v\n%s", err, output)
+	}
+	if got, want := string(output), "delegated|--socket|auto\n"; got != want {
+		t.Fatalf("managed wrapper output = %q, want %q", got, want)
+	}
+}
+
+func TestBootstrapSetupRefusesMissingLLDBMCPPrerequisites(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("macOS bootstrap behavior")
+	}
+	harness := newLLDBMCPSetupHarness(t, false)
+
+	output, err := harness.run(t)
+	if err == nil {
+		t.Fatalf("production setup accepted missing Homebrew and lldb-mcp:\n%s", output)
+	}
+	for _, want := range []string{"Homebrew not found", "cannot install lldb-mcp"} {
+		if !strings.Contains(output, want) {
+			t.Fatalf("production setup failure missing %q:\n%s", want, output)
+		}
+	}
+	if strings.Contains(output, "=== Done ===") {
+		t.Fatalf("production setup printed success after prerequisite refusal:\n%s", output)
+	}
+}
+
+func TestBootstrapSetupInstallsLLDBMCPOnceAndWrapperDelegates(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("macOS bootstrap behavior")
+	}
+	harness := newLLDBMCPSetupHarness(t, true)
+
+	if output, err := harness.run(t); err != nil {
+		t.Fatalf("first production setup failed: %v\n%s", err, output)
+	}
+	wrapper := filepath.Join(harness.brewPrefix, "bin", "lldb-mcp")
+	firstInode := fileInode(t, wrapper)
+	if got := brewInstallCount(t, harness.brewLog); got != 1 {
+		t.Fatalf("brew install count after first setup = %d, want 1", got)
+	}
+	assertWrapperDelegates(t, wrapper)
+
+	if output, err := harness.run(t); err != nil {
+		t.Fatalf("second production setup failed: %v\n%s", err, output)
+	}
+	if got := brewInstallCount(t, harness.brewLog); got != 1 {
+		t.Fatalf("brew install count after second setup = %d, want 1", got)
+	}
+	if got := fileInode(t, wrapper); got != firstInode {
+		t.Fatalf("wrapper inode changed on idempotent setup: first=%d second=%d", firstInode, got)
+	}
+	assertWrapperDelegates(t, wrapper)
+}
+
+func TestBootstrapSetupRepairsManagedLLDBMCPWrapperWithUnreachableExpectedTarget(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("macOS bootstrap behavior")
+	}
+	harness := newLLDBMCPSetupHarness(t, true)
+	if output, err := harness.run(t); err != nil {
+		t.Fatalf("initial production setup failed: %v\n%s", err, output)
+	}
+	wrapper := filepath.Join(harness.brewPrefix, "bin", "lldb-mcp")
+	forged := "#!/bin/sh\n# " + managedLLDBMCPMarker + ".\nexit 0\nexec \"" + filepath.Join(harness.llvmPrefix, "bin", "lldb-mcp") + "\" \"$@\"\n"
+	writeExecutable(t, wrapper, forged)
+
+	if output, err := harness.run(t); err != nil {
+		t.Fatalf("production setup failed to repair forged wrapper: %v\n%s", err, output)
+	}
+	data, err := os.ReadFile(wrapper)
+	if err != nil {
+		t.Fatalf("ReadFile(repaired wrapper): %v", err)
+	}
+	if string(data) == forged || strings.Contains(string(data), "exit 0") {
+		t.Fatalf("production setup retained forged non-delegating wrapper:\n%s", data)
+	}
+	assertWrapperDelegates(t, wrapper)
+	if got := brewInstallCount(t, harness.brewLog); got != 1 {
+		t.Fatalf("wrapper repair reinstalled llvm: brew install count = %d, want 1", got)
+	}
+}
+
+func TestBootstrapSetupRefusesLLVMInstallWithoutExpectedHelper(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("macOS bootstrap behavior")
+	}
+	harness := newLLDBMCPSetupHarness(t, true)
+
+	output, err := harness.run(t, "FAKE_BREW_CREATE_LLVM=0")
+	if err == nil {
+		t.Fatalf("production setup accepted llvm install without lldb-mcp helper:\n%s", output)
+	}
+	if !strings.Contains(output, "Homebrew llvm did not provide expected helper") {
+		t.Fatalf("production setup failure was not actionable:\n%s", output)
+	}
+	if strings.Contains(output, "=== Done ===") {
+		t.Fatalf("production setup printed success after missing helper:\n%s", output)
+	}
+}
