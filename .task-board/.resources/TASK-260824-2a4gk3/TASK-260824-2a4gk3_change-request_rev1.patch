+
+func mainCanonicalOpenAITOML() string {
+	return "[agents.targets.openai]\n" +
+		"vendor=\"openai\"\n" +
+		"environment=\"codex\"\n" +
+		"model=\"gpt-5.6-sol\"\n" +
+		"reasoning=\"high\"\n" +
+		"[agents.entrypoints]\n" +
+		"openai-infra=\"openai\"\n"
+}
+
+func mainCanonicalHostedTOML() string {
+	return "[agents.targets.openai]\n" +
+		"vendor=\"openai\"\n" +
+		"environment=\"codex\"\n" +
+		"model=\"gpt-5.6-sol\"\n" +
+		"reasoning=\"high\"\n" +
+		"[agents.targets.anthropic]\n" +
