+func installCanonicalTargetLaunchers(layout Layout, out io.Writer) error {
+	for _, entrypoint := range canonicalTargetLauncherNames {
+		path := filepath.Join(layout.BinDir, canonicalTargetWrapperName(entrypoint, runtime.GOOS))
+		body := canonicalTargetWrapperBody(entrypoint, runtime.GOOS, piInfraTargetName(layout.Mode, runtime.GOOS))
+		if info, err := os.Lstat(path); err == nil && info.Mode().IsRegular() {
+			modeMatches := runtime.GOOS == "windows" || info.Mode().Perm() == 0o755
+			if existing, readErr := os.ReadFile(path); readErr == nil && string(existing) == body && modeMatches {
+				logf(out, "Canonical target launcher already up to date: %s", path)
+				continue
+			}
+		}
+		if err := removeManagedPath(path, out); err != nil {
+			return err
+		}
+		if err := os.WriteFile(path, []byte(body), 0o755); err != nil {
+			return fmt.Errorf("write canonical target launcher %s: %w", entrypoint, err)
+		}
+		logf(out, "Installed canonical target launcher: %s", path)
+	}
+	return nil
+}
+
+func canonicalTargetWrapperName(entrypoint, goos string) string {
+	if strings.EqualFold(goos, "windows") {
+		return entrypoint + ".cmd"
+	}
+	return entrypoint
+}
+
+func canonicalTargetWrapperBody(entrypoint, goos, targetName string) string {
+	if strings.EqualFold(goos, "windows") {
+		return fmt.Sprintf("@echo off\r\nsetlocal\r\nset \"DIR=%%~dp0\"\r\nif not exist \"%%DIR%%%s\" (\r\n  echo %s: missing or non-regular sibling %%DIR%%%s 1^>^&2\r\n  exit /b 127\r\n)\r\n\"%%DIR%%%s\" target %s %%*\r\nexit /b %%ERRORLEVEL%%\r\n", targetName, entrypoint, targetName, targetName, entrypoint)
+	}
+	return fmt.Sprintf(`#!/usr/bin/env sh
+set -eu
+DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+TARGET="$DIR/%s"
+if [ ! -f "$TARGET" ] || [ -L "$TARGET" ] || [ ! -x "$TARGET" ]; then
+  echo "%s: missing or non-regular sibling $TARGET" >&2
+  exit 127
+fi
+exec "$TARGET" target %s "$@"
+`, targetName, entrypoint, entrypoint)
+}
