@@ -39,6 +39,14 @@ argv = [
 # runtime. A plain non-zero exit -- a refused model directory, a missing shader
 # library, a rejected flag -- is a configuration error that a restart loop would
 # hide instead of report.
+#
+# There is deliberately no policy for a *recoverable* generation failure, and
+# there should not be one. A generation that fails mid-batch on a runtime that
+# can still serve releases its batch entry and KV cache, keeps the worker, and
+# lets the next request through on the same process -- see `GET
+# /debug/generation-state` and `scripts/generation-batch-recovery-smoke.sh`.
+# Restarting on that would throw away a resident multi-GiB model to recover
+# from a single failed request.
 [profiles.qwen-mlx-swift-prototype.supervision]
