+                name: "generation_shared_cache_rebuilt",
+                fields: [
+                    "reason": .string("worker_teardown"),
+                    "shared_cache_rebuilds": .int(ledger.sharedCacheRebuilds),
+                    // Both sides of the clear. The `before` pair is what makes
+                    // a mis-ordered teardown legible instead of merely wrong:
+                    // high active bytes here means the weights had not been
+                    // released yet and the clear returned nothing.
+                    "active_bytes_before": .int(before.activeMemory),
+                    "cache_bytes_before": .int(before.cacheMemory),
+                    "active_bytes": .int(usage.activeBytes),
+                    "cache_bytes": .int(usage.cacheBytes),
+                ]))
+    }
+
+    /// The active-byte reading taken when the worker was condemned, if a
+    /// deferred rebuild is still outstanding.
+    func pendingTeardownBaseline() -> Int? {
+        rebuildPendingWorkerTeardown ? condemnedActiveBytes : nil
+    }
+
+    /// Wait, bounded, for MLX to report that the weights have actually been
+    /// released.
+    ///
+    /// `nonisolated` and `static` so the wait happens off the ledger actor:
+    /// `GET /debug/generation-state` reads that actor, and an operator asking
+    /// what a condemned runtime is holding must not queue behind this.
+    ///
+    /// A wait rather than an assumed ordering because the ordering cannot be
+    /// assumed. `GenerationEngine.deinit` runs before its stored properties are
+    /// released, and MLX returns buffers through its own scoped pools, so the
+    /// weights are still active for a short while after the last reference
+    /// goes. Two earlier attempts — clearing from the failing request, then
+    /// clearing right after the response was written — both measured ~303 MB
+    /// still active at the moment of the clear.
+    ///
+    /// - Returns: `true` if the release was observed, `false` if the bound
+    ///   expired first. A `false` is reported rather than hidden: the clear
+    ///   still happens, but the event says the runtime did not see what it was
+    ///   waiting for.
+    nonisolated static func waitForWeightRelease(below threshold: Int) async -> Bool {
+        for _ in 0 ..< 100 {
+            if Memory.snapshot().activeMemory < threshold { return true }
+            try? await Task.sleep(nanoseconds: 20_000_000)
+        }
+        return false
+    }
+
+    /// Allocator counters as of now, for `GET /debug/generation-state`.
+    func memoryUsage() -> GenerationBatchReport.MemoryUsage {
+        let snapshot = Memory.snapshot()
+        return GenerationBatchReport.MemoryUsage(
+            activeBytes: snapshot.activeMemory,
+            cacheBytes: snapshot.cacheMemory,
+            peakBytes: snapshot.peakMemory)
+    }
+}
