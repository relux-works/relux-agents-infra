diff --git a/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BatchLedgerStore.swift b/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BatchLedgerStore.swift
