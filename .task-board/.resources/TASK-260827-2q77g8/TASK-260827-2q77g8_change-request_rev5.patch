+        // Specifically: the failure was not laundered into a completion.
+        #expect(ledger.completed == 0)
+    }
+
+    @Test("a slot from another ledger is not honoured")
+    func foreignSlotIsRefused() {
+        var issuing = GenerationBatchLedger()
