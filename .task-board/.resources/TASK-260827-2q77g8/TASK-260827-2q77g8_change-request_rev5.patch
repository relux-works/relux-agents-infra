+        && pass "TEARDOWN GATE: the abandonment re-announces the process as unusable" \
+        || fail "TEARDOWN GATE: an abandoned rebuild left no supervision marker naming it"
+else
+    fail "retained-teardown run never became ready"
+fi
+stop_harness
