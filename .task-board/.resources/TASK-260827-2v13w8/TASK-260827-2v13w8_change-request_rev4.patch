+        minPrefillThroughputRatio: 0.90,
+        minDecodeThroughputRatio: 0.90,
+        maxPeakFootprintRatio: 1.10,
+        maxPromptTokenSkewRatio: 1.10,
+        paritySuccessScenarios: ["short_prompt"],
+        scoredScenarios: ["short_prompt"])
