+accumulated = bytearray()
+for name in ("config.json", "model.safetensors.index.json"):
+    accumulated += name.encode()
+    accumulated += open(os.path.join(sys.argv[1], name), "rb").read()
+print(hashlib.sha256(bytes(accumulated)).hexdigest())
