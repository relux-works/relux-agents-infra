+            Self.document(
+                "tool_call",
+                """
+                {"kind": "tool", "prompt": "Read it.", "max_tokens": 32,
+                 "tools": [{"type": "function", "function": {"name": "read_pressure",
+                   "parameters": {"type": "object",
