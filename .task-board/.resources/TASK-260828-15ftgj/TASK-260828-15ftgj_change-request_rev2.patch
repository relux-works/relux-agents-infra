+        case "K": multiplier = 1_024
+        case "M": multiplier = 1_024 * 1_024
+        case "G": multiplier = 1_024 * 1_024 * 1_024
+        case "T": multiplier = 1_024 * 1_024 * 1_024 * 1_024
