+    /// ``ModelEquivalenceReading``. No path given is
+    /// ``ModelEquivalenceReading/noneDeclared``; a path that reads and decodes
+    /// is ``ModelEquivalenceReading/read(_:digest:)``; a path that does not is
+    /// ``ModelEquivalenceReading/unread(path:)`` and is refused downstream
+    /// rather than quietly becoming the first case. That distinction is the
+    /// whole point of returning a reading instead of an optional: an
+    /// unreadable verdict beside two different weight files would otherwise
+    /// admit them as one model.
+    static func equivalenceReading(path: String?) -> ModelEquivalenceReading {
+        guard let path else { return .noneDeclared }
