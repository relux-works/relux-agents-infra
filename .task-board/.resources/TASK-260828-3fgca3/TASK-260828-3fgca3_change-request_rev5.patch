+
+[profiles.gate-smoke-candidate]
+mode = "local"
+executable = "$CANDIDATE_PYTHON"
+argv = [
+    "$OUT/fake-runtime.py", "{port}", "$MODEL", "serving",
+    $cand_meta
+    $cand_probe
+    "--host", "{host}",
+    "--model", "$MODEL",
+    "--reasoning-effort", "medium",
