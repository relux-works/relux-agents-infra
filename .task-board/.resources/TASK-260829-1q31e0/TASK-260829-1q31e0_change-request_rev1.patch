+func TestRunPiRequiresExplicitPositiveLifecycleLogRetention(t *testing.T) {
+	valid := validPiProfileTOML("profile", "/bin/echo", 18011, false)
+	table := `[agents.pi.profiles."profile".lifecycle_log_retention]
+max_count = 64
+max_bytes = 1048576
+max_age_seconds = 604800
+`
+	tests := map[string]string{
+		"absent table":    strings.Replace(valid, table, "", 1),
+		"missing count":   strings.Replace(valid, "max_count = 64\n", "", 1),
+		"zero count":      strings.Replace(valid, "max_count = 64", "max_count = 0", 1),
+		"missing bytes":   strings.Replace(valid, "max_bytes = 1048576\n", "", 1),
+		"zero bytes":      strings.Replace(valid, "max_bytes = 1048576", "max_bytes = 0", 1),
+		"missing age":     strings.Replace(valid, "max_age_seconds = 604800\n", "", 1),
+		"zero age":        strings.Replace(valid, "max_age_seconds = 604800", "max_age_seconds = 0", 1),
+		"unknown default": strings.Replace(valid, "max_count = 64", "max_count = 64\ndefault_days = 7", 1),
+	}
+	for name, body := range tests {
+		t.Run(name, func(t *testing.T) {
+			project, home := t.TempDir(), t.TempDir()
+			cache := filepath.Join(t.TempDir(), "cache")
+			writePiProjectConfig(t, project, body)
+			providerLookup := false
+			err := RunPi(RunPiOptions{
+				ProjectDir: project,
+				HomeDir:    home,
+				CacheRoot:  cache,
+				Environ:    []string{},
+				LookPath: func(string) (string, error) {
+					providerLookup = true
+					return "/bin/false", nil
+				},
+			})
+			if piErrorCode(err) != "invalid_project_configuration" {
+				t.Fatalf("RunPi error=%v code=%q", err, piErrorCode(err))
+			}
+			if !strings.Contains(err.Error(), "lifecycle_log_retention") {
+				t.Fatalf("RunPi error does not name production gate: %v", err)
+			}
+			if providerLookup {
+				t.Fatal("invalid retention reached provider lookup")
+			}
+			if _, statErr := os.Stat(cache); !errors.Is(statErr, os.ErrNotExist) {
+				t.Fatalf("invalid retention mutated managed state: %v", statErr)
+			}
+		})
+	}
+}
