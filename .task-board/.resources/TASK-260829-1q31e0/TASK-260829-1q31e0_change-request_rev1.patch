+func TestPiLifecycleLogPruningRefusesIdentityReplacementWithoutDeletingForeignOrActive(t *testing.T) {
+	state := newPiLifecycleLogTestState(t)
+	now := time.Date(2026, time.August, 29, 13, 0, 0, 0, time.UTC)
+	policy := PiLifecycleLogRetention{MaxCount: 1, MaxBytes: 1 << 20, MaxAgeSeconds: 24 * 60 * 60}
+	active := writePiLifecycleLogFixture(t, state, now, 1, 20, 0o600)
+	writePiLifecycleLogFixture(t, state, now.Add(-time.Hour), 2, 20, 0o600)
+	foreign := filepath.Join(state.LogsDir, "foreign.keep")
+	if err := os.WriteFile(foreign, []byte("foreign"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	replaced := ""
+	_, err := prunePiLifecycleLogsWithRemove(state, policy, now, filepath.Base(active), 0, func(logsFD int, candidate piLifecycleLogCandidate) error {
+		replaced = filepath.Join(state.LogsDir, candidate.name)
+		if err := os.Rename(replaced, replaced+".original"); err != nil {
+			return err
+		}
+		if err := os.WriteFile(replaced, []byte("foreign replacement"), 0o644); err != nil {
+			return err
+		}
+		return removePiLifecycleLog(logsFD, candidate)
+	})
+	if piErrorCode(err) != "lifecycle_log_retention_failed" {
+		t.Fatalf("identity replacement error=%v code=%q", err, piErrorCode(err))
+	}
+	for _, path := range []string{active, foreign, replaced, replaced + ".original"} {
+		if _, err := os.Lstat(path); err != nil {
+			t.Fatalf("refusal deleted %s: %v", filepath.Base(path), err)
+		}
+	}
+}
