+func TestPiLifecycleLogPruningCrashAfterOneDeleteLeavesActiveAndForeignFiles(t *testing.T) {
+	state := newPiLifecycleLogTestState(t)
+	now := time.Date(2026, time.August, 29, 14, 0, 0, 0, time.UTC)
+	policy := PiLifecycleLogRetention{MaxCount: 1, MaxBytes: 1 << 20, MaxAgeSeconds: 24 * 60 * 60}
+	active := writePiLifecycleLogFixture(t, state, now, 1, 20, 0o600)
+	writePiLifecycleLogFixture(t, state, now.Add(-time.Hour), 2, 20, 0o600)
+	writePiLifecycleLogFixture(t, state, now.Add(-2*time.Hour), 3, 20, 0o600)
+	foreign := filepath.Join(state.LogsDir, "foreign.keep")
+	if err := os.WriteFile(foreign, []byte("foreign"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	removals := 0
+	crash := errors.New("simulated crash")
+	_, err := prunePiLifecycleLogsWithRemove(state, policy, now, filepath.Base(active), 0, func(logsFD int, candidate piLifecycleLogCandidate) error {
+		removals++
+		if removals == 2 {
+			return crash
+		}
+		return removePiLifecycleLog(logsFD, candidate)
+	})
+	if !errors.Is(err, crash) {
+		t.Fatalf("prune error=%v want simulated crash", err)
+	}
+	for _, path := range []string{active, foreign} {
+		if _, err := os.Lstat(path); err != nil {
+			t.Fatalf("partial prune deleted protected path %s: %v", filepath.Base(path), err)
+		}
+	}
+	footprint := observePiLifecycleLogFootprint(state, policy, now, "")
+	if footprint.ManagedCount != 2 || footprint.ForeignCount != 1 {
+		t.Fatalf("partial prune footprint=%#v want two managed and one foreign", footprint)
+	}
+}
