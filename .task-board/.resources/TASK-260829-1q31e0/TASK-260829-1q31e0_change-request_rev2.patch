+}
+
+func resolvePiLifecycleLogTestState(t *testing.T, cache, project, runID string) PiStatePaths {
+	t.Helper()
+	var state PiStatePaths
+	var err error
+	if runID == "" {
+		state, err = ResolvePiStatePaths(cache, project, "profile")
+	} else {
+		state, err = ResolvePiClientStatePaths(cache, project, "profile", runID)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := CreatePiStateTree(state); err != nil {
+		t.Fatal(err)
+	}
+	return state
+}
