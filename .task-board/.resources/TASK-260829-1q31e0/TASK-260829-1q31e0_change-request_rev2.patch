+	}
+	for day := 0; day < 8*7; day++ {
+		for turn := 0; turn < 3; turn++ {
+			current = current.Add(8 * time.Hour)
+			runID := fmt.Sprintf("RUN-week-%02d-turn-%d", day, turn)
+			runState := resolvePiLifecycleLogTestState(t, cache, project, runID)
+			log, err := openPiSessionLogAt(runState, policy, func() time.Time { return current })
+			if err != nil {
+				t.Fatalf("day=%d turn=%d open: %v", day, turn, err)
+			}
+			log.event("turn", map[string]any{"day": day, "turn": turn})
+			if log.status.DroppedRecords != 0 {
+				t.Fatalf("day=%d turn=%d dropped=%d error=%s", day, turn, log.status.DroppedRecords, log.status.LastError)
+			}
+			log.close()
+		}
+	}
+	if _, err := os.Lstat(foreign); err != nil {
+		t.Fatalf("week simulation deleted foreign evidence: %v", err)
+	}
+	footprint := observePiLifecycleLogFootprint(state, policy, current, "")
+	if !footprint.WithinPolicy || footprint.ManagedCount > policy.MaxCount || footprint.ManagedBytes > policy.MaxBytes || footprint.ExpiredCount != 0 {
+		t.Fatalf("eight-week footprint exceeds policy: %#v policy=%#v", footprint, policy)
+	}
+	if footprint.OldestStarted != nil && footprint.OldestStarted.Before(current.Add(-time.Duration(policy.MaxAgeSeconds)*time.Second)) {
+		t.Fatalf("oldest retained lifecycle log %s exceeds age policy at %s", footprint.OldestStarted, current)
+	}
+	t.Logf("simulated_weeks=8 managed_count=%d/%d managed_bytes=%d/%d expired_count=%d foreign_count=%d within_policy=%t",
+		footprint.ManagedCount, policy.MaxCount, footprint.ManagedBytes, policy.MaxBytes, footprint.ExpiredCount, footprint.ForeignCount, footprint.WithinPolicy)
+}
+
+// Production call site: BuildPrimarySessionLaunchPlan, used by
+// pi-infra --print-config, publishes configured bounds and observed footprint.
+func TestPiPrintConfigReportsLifecycleLogPolicyAndFootprintWithoutPruning(t *testing.T) {
+	piRoot := officialPiAsset(t)
+	project, home := t.TempDir(), t.TempDir()
+	cache := filepath.Join(home, "Library", "Caches")
+	mustMkdir(t, cache)
+	t.Setenv("HOME", home)
+	writePiProjectConfig(t, project, validPiProfileTOML("profile", "/bin/echo", 18011, false))
+	canonicalProject, err := CanonicalProjectDir(project)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state, err := ResolvePiStatePaths("", canonicalProject, "profile")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := CreatePiStateTree(state); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC()
+	runState, err := ResolvePiClientStatePaths(cache, canonicalProject, "profile", "RUN-print-config")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := CreatePiStateTree(runState); err != nil {
+		t.Fatal(err)
+	}
+	owned := writePiLifecycleLogFixture(t, runState, now.Add(-time.Hour), 1, 33, 0o600)
+	foreign := filepath.Join(runState.LogsDir, "operator.keep")
+	if err := os.WriteFile(foreign, []byte("foreign"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	plan, err := BuildPrimarySessionLaunchPlan("pi", project, home, nil, ChildLaunchCompositionProducer{}, func(string) (string, error) {
+		return filepath.Join(piRoot, "pi"), nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantPolicy := PiLifecycleLogRetention{MaxCount: 64, MaxBytes: 1048576, MaxAgeSeconds: 604800}
+	if plan.Pi == nil || plan.Pi.LifecycleLogs == nil || !reflect.DeepEqual(plan.Pi.LifecycleLogs.Retention, wantPolicy) {
+		t.Fatalf("lifecycle log diagnostics absent or wrong: %#v", plan.Pi)
+	}
+	got := plan.Pi.LifecycleLogs.Footprint
+	if got.Observation != "present" || got.ParticipatingDirectoryCount != 2 || got.ManagedCount != 1 || got.ManagedBytes != 33 || got.ForeignCount != 1 || !got.WithinPolicy {
+		t.Fatalf("lifecycle log footprint=%#v", got)
+	}
+	for _, path := range []string{owned, foreign} {
+		if _, err := os.Lstat(path); err != nil {
+			t.Fatalf("print-config pruned %s: %v", filepath.Base(path), err)
+		}
+	}
+}
