diff --git a/tools/agents-infra/internal/infra/pi_lifecycle_log_posix.go b/tools/agents-infra/internal/infra/pi_lifecycle_log_posix.go
new file mode 100644
index 0000000..7968bf2
--- /dev/null
+++ b/tools/agents-infra/internal/infra/pi_lifecycle_log_posix.go
@@ -0,0 +1,524 @@
+//go:build !windows
+
+package infra
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	piLifecycleLogTimestampLayout = "20060102T150405.000000000Z"
+	piLifecycleRetentionLockName  = "lifecycle-logs.lock"
+)
+
+var piLifecycleLogNamePattern = regexp.MustCompile(`^([0-9]{8}T[0-9]{6}\.[0-9]{9}Z)-[0-9a-f]{16}\.jsonl$`)
+
+type piLifecycleLogIdentity struct {
+	device uint64
+	inode  uint64
+}
+
+type piLifecycleLogCandidate struct {
+	name        string
+	path        string
+	runStateKey string
+	startedAt   time.Time
+	size        int64
+	identity    piLifecycleLogIdentity
+	active      bool
+}
+
+type piLifecycleLogDirectory struct {
+	path        string
+	runStateKey string
+	fd          int
+}
+
+type piLifecycleLogScan struct {
+	candidates []piLifecycleLogCandidate
+	footprint  PiLifecycleLogFootprint
+}
+
+type piLifecycleLogPruneResult struct {
+	Before      PiLifecycleLogFootprint
+	After       PiLifecycleLogFootprint
+	PrunedCount int
+	PrunedBytes int64
+}
+
+type piLifecycleLogRemove func(paths PiStatePaths, candidate piLifecycleLogCandidate) error
+
+type piLifecycleRetentionLock struct {
+	file *os.File
+}
+
+func (lock *piLifecycleRetentionLock) close() {
+	if lock == nil || lock.file == nil {
+		return
+	}
+	_ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN)
+	_ = lock.file.Close()
+	lock.file = nil
+}
+
+func observePiLifecycleLogFootprint(paths PiStatePaths, policy PiLifecycleLogRetention, now time.Time, activePath string) PiLifecycleLogFootprint {
+	lock, present, err := acquirePiLifecycleRetentionLock(paths, false, unix.LOCK_SH)
+	if err != nil {
+		return PiLifecycleLogFootprint{Observation: "unknown", Error: err.Error()}
+	}
+	if present {
+		defer lock.close()
+	}
+	scan, err := scanPiLifecycleLogs(paths, activePath, policy, now)
+	if err != nil {
+		return PiLifecycleLogFootprint{Observation: "unknown", Error: err.Error()}
+	}
+	return scan.footprint
+}
+
+func piLifecycleProfileComponents(paths PiStatePaths) ([]string, error) {
+	if !piStateKeyPattern.MatchString(paths.ProjectStateKey) || !piStateKeyPattern.MatchString(paths.ProfileStateKey) {
+		return nil, errors.New("lifecycle log profile state keys are invalid")
+	}
+	return []string{"agents-infra", "pi", paths.ProjectStateKey, paths.ProfileStateKey}, nil
+}
+
+func piLifecycleProfileRootPath(paths PiStatePaths) string {
+	components, err := piLifecycleProfileComponents(paths)
+	if err != nil {
+		return ""
+	}
+	return filepath.Join(append([]string{paths.CanonicalCacheRoot}, components...)...)
+}
+
+func openPiLifecycleProfileRoot(paths PiStatePaths) (int, error) {
+	components, err := piLifecycleProfileComponents(paths)
+	if err != nil {
+		return -1, err
+	}
+	rootFD, err := unix.Open(paths.CanonicalCacheRoot, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return -1, err
+	}
+	fd := rootFD
+	for _, name := range components {
+		next, openErr := unix.Openat(fd, name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if fd != rootFD {
+			unix.Close(fd)
+		}
+		if openErr != nil {
+			unix.Close(rootFD)
+			return -1, openErr
+		}
+		fd = next
+	}
+	unix.Close(rootFD)
+	return fd, nil
+}
+
+func acquirePiLifecycleRetentionLock(paths PiStatePaths, create bool, operation int) (*piLifecycleRetentionLock, bool, error) {
+	profileFD, err := openPiLifecycleProfileRoot(paths)
+	if errors.Is(err, syscall.ENOENT) && !create {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	defer unix.Close(profileFD)
+	flags := unix.O_RDWR | unix.O_CLOEXEC | unix.O_NOFOLLOW
+	if create {
+		flags |= unix.O_CREAT
+	}
+	fd, err := unix.Openat(profileFD, piLifecycleRetentionLockName, flags, 0o600)
+	if errors.Is(err, syscall.ENOENT) && !create {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	file := os.NewFile(uintptr(fd), filepath.Join(piLifecycleProfileRootPath(paths), piLifecycleRetentionLockName))
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil || stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Nlink != 1 || stat.Mode&0o7777 != 0o600 {
+		if err == nil {
+			err = errors.New("lifecycle log retention lock must be a mode-0600 single-link regular file")
+		}
+		_ = file.Close()
+		return nil, false, err
+	}
+	if err := unix.Flock(fd, operation); err != nil {
+		_ = file.Close()
+		return nil, false, err
+	}
+	return &piLifecycleRetentionLock{file: file}, true, nil
+}
+
+func openPiLifecycleLogsDir(paths PiStatePaths, runStateKey string) (int, error) {
+	profileFD, err := openPiLifecycleProfileRoot(paths)
+	if err != nil {
+		return -1, err
+	}
+	defer unix.Close(profileFD)
+	parentFD := profileFD
+	if runStateKey != "" {
+		if !piStateKeyPattern.MatchString(runStateKey) {
+			return -1, errors.New("lifecycle log run state key is invalid")
+		}
+		runsFD, err := unix.Openat(profileFD, "runs", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if err != nil {
+			return -1, err
+		}
+		defer unix.Close(runsFD)
+		runFD, err := unix.Openat(runsFD, runStateKey, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if err != nil {
+			return -1, err
+		}
+		defer unix.Close(runFD)
+		parentFD = runFD
+	}
+	return unix.Openat(parentFD, "logs", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+}
+
+func readPiLifecycleDirectory(fd int, label string) ([]os.DirEntry, error) {
+	if _, err := unix.Seek(fd, 0, 0); err != nil {
+		return nil, err
+	}
+	dupFD, err := unix.Dup(fd)
+	if err != nil {
+		return nil, err
+	}
+	directory := os.NewFile(uintptr(dupFD), label)
+	entries, readErr := directory.ReadDir(-1)
+	closeErr := directory.Close()
+	if readErr != nil {
+		return nil, readErr
+	}
+	if closeErr != nil {
+		return nil, closeErr
+	}
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+	return entries, nil
+}
+
+func openPiLifecycleLogDirectories(paths PiStatePaths) ([]piLifecycleLogDirectory, error) {
+	profileFD, err := openPiLifecycleProfileRoot(paths)
+	if errors.Is(err, syscall.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(profileFD)
+	directories := make([]piLifecycleLogDirectory, 0)
+	closeOnError := func() {
+		for _, directory := range directories {
+			unix.Close(directory.fd)
+		}
+	}
+	logsFD, err := unix.Openat(profileFD, "logs", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err == nil {
+		directories = append(directories, piLifecycleLogDirectory{path: filepath.Join(piLifecycleProfileRootPath(paths), "logs"), fd: logsFD})
+	} else if !errors.Is(err, syscall.ENOENT) {
+		return nil, fmt.Errorf("open profile lifecycle log directory: %w", err)
+	}
+	runsFD, err := unix.Openat(profileFD, "runs", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, syscall.ENOENT) {
+		return directories, nil
+	}
+	if err != nil {
+		closeOnError()
+		return nil, fmt.Errorf("open lifecycle run-state directory: %w", err)
+	}
+	defer unix.Close(runsFD)
+	entries, err := readPiLifecycleDirectory(runsFD, "pi-lifecycle-runs")
+	if err != nil {
+		closeOnError()
+		return nil, err
+	}
+	for _, entry := range entries {
+		runStateKey := entry.Name()
+		if !piStateKeyPattern.MatchString(runStateKey) {
+			continue
+		}
+		runFD, err := unix.Openat(runsFD, runStateKey, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		if err != nil {
+			closeOnError()
+			return nil, fmt.Errorf("open lifecycle run state %q: %w", runStateKey, err)
+		}
+		logsFD, err := unix.Openat(runFD, "logs", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		unix.Close(runFD)
+		if errors.Is(err, syscall.ENOENT) {
+			continue
+		}
+		if err != nil {
+			closeOnError()
+			return nil, fmt.Errorf("open lifecycle logs for run state %q: %w", runStateKey, err)
+		}
+		directories = append(directories, piLifecycleLogDirectory{
+			path:        filepath.Join(piLifecycleProfileRootPath(paths), "runs", runStateKey, "logs"),
+			runStateKey: runStateKey,
+			fd:          logsFD,
+		})
+	}
+	return directories, nil
+}
+
+func scanPiLifecycleLogs(paths PiStatePaths, activePath string, policy PiLifecycleLogRetention, now time.Time) (piLifecycleLogScan, error) {
+	directories, err := openPiLifecycleLogDirectories(paths)
+	if err != nil {
+		return piLifecycleLogScan{}, err
+	}
+	defer func() {
+		for _, directory := range directories {
+			unix.Close(directory.fd)
+		}
+	}()
+	if len(directories) == 0 {
+		return piLifecycleLogScan{footprint: PiLifecycleLogFootprint{Observation: "absent", WithinPolicy: true}}, nil
+	}
+	scan := piLifecycleLogScan{footprint: PiLifecycleLogFootprint{Observation: "present", ParticipatingDirectoryCount: len(directories)}}
+	for _, directory := range directories {
+		entries, err := readPiLifecycleDirectory(directory.fd, directory.path)
+		if err != nil {
+			return piLifecycleLogScan{}, err
+		}
+		for _, entry := range entries {
+			var stat unix.Stat_t
+			if err := unix.Fstatat(directory.fd, entry.Name(), &stat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+				return piLifecycleLogScan{}, fmt.Errorf("inspect lifecycle log entry %q: %w", filepath.Join(directory.path, entry.Name()), err)
+			}
+			size := stat.Size
+			if size < 0 {
+				return piLifecycleLogScan{}, fmt.Errorf("lifecycle log entry %q has negative size", filepath.Join(directory.path, entry.Name()))
+			}
+			if err := addPiLifecycleBytes(&scan.footprint.DirectoryBytes, size); err != nil {
+				return piLifecycleLogScan{}, err
+			}
+			scan.footprint.DirectoryCount++
+			startedAt, ownedName := parsePiLifecycleLogName(entry.Name())
+			ownedShape := stat.Mode&unix.S_IFMT == unix.S_IFREG && stat.Nlink == 1 && stat.Mode&0o7777 == 0o600
+			if !ownedName || !ownedShape {
+				scan.footprint.ForeignCount++
+				if err := addPiLifecycleBytes(&scan.footprint.ForeignBytes, size); err != nil {
+					return piLifecycleLogScan{}, err
+				}
+				continue
+			}
+			path := filepath.Join(directory.path, entry.Name())
+			active := path == activePath
+			if !active {
+				active, err = piLifecycleLogIsActive(directory.fd, entry.Name())
+				if err != nil {
+					return piLifecycleLogScan{}, fmt.Errorf("inspect lifecycle log activity %q: %w", path, err)
+				}
+			}
+			candidate := piLifecycleLogCandidate{
+				name:        entry.Name(),
+				path:        path,
+				runStateKey: directory.runStateKey,
+				startedAt:   startedAt,
+				size:        size,
+				identity:    piLifecycleLogIdentity{device: uint64(stat.Dev), inode: uint64(stat.Ino)},
+				active:      active,
+			}
+			scan.candidates = append(scan.candidates, candidate)
+			scan.footprint.ManagedCount++
+			if err := addPiLifecycleBytes(&scan.footprint.ManagedBytes, size); err != nil {
+				return piLifecycleLogScan{}, err
+			}
+			if candidate.active {
+				scan.footprint.ActiveCount++
+			} else if startedAt.Before(now.Add(-time.Duration(policy.MaxAgeSeconds) * time.Second)) {
+				scan.footprint.ExpiredCount++
+			}
+			if scan.footprint.OldestStarted == nil || startedAt.Before(*scan.footprint.OldestStarted) {
+				copy := startedAt
+				scan.footprint.OldestStarted = &copy
+			}
+			if scan.footprint.NewestStarted == nil || startedAt.After(*scan.footprint.NewestStarted) {
+				copy := startedAt
+				scan.footprint.NewestStarted = &copy
+			}
+		}
+	}
+	scan.footprint.WithinPolicy = scan.footprint.ManagedCount <= policy.MaxCount &&
+		scan.footprint.ManagedBytes <= policy.MaxBytes && scan.footprint.ExpiredCount == 0
+	return scan, nil
+}
+
+func piLifecycleLogIsActive(logsFD int, name string) (bool, error) {
+	fd, err := unix.Openat(logsFD, name, unix.O_RDONLY|unix.O_NONBLOCK|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return false, err
+	}
+	defer unix.Close(fd)
+	if err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, syscall.EWOULDBLOCK) {
+			return true, nil
+		}
+		return false, err
+	}
+	if err := unix.Flock(fd, unix.LOCK_UN); err != nil {
+		return false, err
+	}
+	return false, nil
+}
+
+func parsePiLifecycleLogName(name string) (time.Time, bool) {
+	match := piLifecycleLogNamePattern.FindStringSubmatch(name)
+	if match == nil {
+		return time.Time{}, false
+	}
+	startedAt, err := time.Parse(piLifecycleLogTimestampLayout, match[1])
+	if err != nil {
+		return time.Time{}, false
+	}
+	return startedAt, true
+}
+
+func addPiLifecycleBytes(total *int64, size int64) error {
+	if size < 0 || *total > math.MaxInt64-size {
+		return errors.New("lifecycle log aggregate byte count overflow")
+	}
+	*total += size
+	return nil
+}
+
+func prunePiLifecycleLogs(paths PiStatePaths, policy PiLifecycleLogRetention, now time.Time, activePath string, reserveCount int, reserveBytes int64) (piLifecycleLogPruneResult, error) {
+	lock, _, err := acquirePiLifecycleRetentionLock(paths, true, unix.LOCK_EX)
+	if err != nil {
+		return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+	}
+	defer lock.close()
+	return prunePiLifecycleLogsLocked(paths, policy, now, activePath, reserveCount, reserveBytes, removePiLifecycleLog)
+}
+
+func prunePiLifecycleLogsWithRemove(paths PiStatePaths, policy PiLifecycleLogRetention, now time.Time, activePath string, reserveCount int, reserveBytes int64, remove piLifecycleLogRemove) (piLifecycleLogPruneResult, error) {
+	lock, _, err := acquirePiLifecycleRetentionLock(paths, true, unix.LOCK_EX)
+	if err != nil {
+		return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+	}
+	defer lock.close()
+	return prunePiLifecycleLogsLocked(paths, policy, now, activePath, reserveCount, reserveBytes, remove)
+}
+
+func prunePiLifecycleLogsLocked(paths PiStatePaths, policy PiLifecycleLogRetention, now time.Time, activePath string, reserveCount int, reserveBytes int64, remove piLifecycleLogRemove) (piLifecycleLogPruneResult, error) {
+	if reserveCount < 0 || reserveCount > 1 {
+		return piLifecycleLogPruneResult{}, errors.New("lifecycle log count reservation must be zero or one")
+	}
+	if reserveBytes < 0 {
+		return piLifecycleLogPruneResult{}, errors.New("lifecycle log byte reservation must not be negative")
+	}
+	scan, err := scanPiLifecycleLogs(paths, activePath, policy, now)
+	if err != nil {
+		return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+	}
+	result := piLifecycleLogPruneResult{Before: scan.footprint, After: scan.footprint}
+	retainedCount := scan.footprint.ActiveCount + reserveCount
+	retainedBytes := int64(0)
+	for _, candidate := range scan.candidates {
+		if candidate.active {
+			if err := addPiLifecycleBytes(&retainedBytes, candidate.size); err != nil {
+				return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+			}
+		}
+	}
+	if retainedCount > policy.MaxCount || retainedBytes > policy.MaxBytes || reserveBytes > policy.MaxBytes-retainedBytes {
+		return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_exhausted", errors.New("active lifecycle logs and the requested reservation exceed profile retention bounds"))
+	}
+	retainedBytes += reserveBytes
+	inactive := make([]piLifecycleLogCandidate, 0, len(scan.candidates))
+	for _, candidate := range scan.candidates {
+		if !candidate.active {
+			inactive = append(inactive, candidate)
+		}
+	}
+	sort.Slice(inactive, func(i, j int) bool {
+		if inactive[i].startedAt.Equal(inactive[j].startedAt) {
+			return inactive[i].path > inactive[j].path
+		}
+		return inactive[i].startedAt.After(inactive[j].startedAt)
+	})
+	cutoff := now.Add(-time.Duration(policy.MaxAgeSeconds) * time.Second)
+	closedPrefix := false
+	toDelete := make([]piLifecycleLogCandidate, 0)
+	for _, candidate := range inactive {
+		fitsBytes := candidate.size <= policy.MaxBytes-retainedBytes
+		retain := !closedPrefix && !candidate.startedAt.Before(cutoff) && retainedCount < policy.MaxCount && fitsBytes
+		if retain {
+			retainedCount++
+			retainedBytes += candidate.size
+			continue
+		}
+		closedPrefix = true
+		toDelete = append(toDelete, candidate)
+	}
+	for _, candidate := range toDelete {
+		if candidate.active || candidate.path == activePath {
+			return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", errors.New("prune plan included an active lifecycle log"))
+		}
+		if err := remove(paths, candidate); err != nil {
+			return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+		}
+		result.PrunedCount++
+		result.PrunedBytes += candidate.size
+	}
+	after, err := scanPiLifecycleLogs(paths, activePath, policy, now)
+	if err != nil {
+		return piLifecycleLogPruneResult{}, piError("lifecycle_log_retention_failed", err)
+	}
+	result.After = after.footprint
+	return result, nil
+}
+
+func removePiLifecycleLog(paths PiStatePaths, candidate piLifecycleLogCandidate) error {
+	logsFD, err := openPiLifecycleLogsDir(paths, candidate.runStateKey)
+	if err != nil {
+		return fmt.Errorf("reopen lifecycle log directory for %q: %w", candidate.path, err)
+	}
+	defer unix.Close(logsFD)
+	fd, err := unix.Openat(logsFD, candidate.name, unix.O_RDONLY|unix.O_NONBLOCK|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return fmt.Errorf("reopen lifecycle log %q before prune: %w", candidate.path, err)
+	}
+	defer unix.Close(fd)
+	if err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if errors.Is(err, syscall.EWOULDBLOCK) {
+			return fmt.Errorf("lifecycle log %q became active before prune", candidate.path)
+		}
+		return err
+	}
+	defer unix.Flock(fd, unix.LOCK_UN)
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil {
+		return err
+	}
+	identity := piLifecycleLogIdentity{device: uint64(stat.Dev), inode: uint64(stat.Ino)}
+	if stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Nlink != 1 || stat.Mode&0o7777 != 0o600 || identity != candidate.identity || stat.Size != candidate.size {
+		return fmt.Errorf("lifecycle log %q changed identity or ownership before prune", candidate.path)
+	}
+	var pathStat unix.Stat_t
+	if err := unix.Fstatat(logsFD, candidate.name, &pathStat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	pathIdentity := piLifecycleLogIdentity{device: uint64(pathStat.Dev), inode: uint64(pathStat.Ino)}
+	if pathIdentity != candidate.identity || pathStat.Mode&unix.S_IFMT != unix.S_IFREG || pathStat.Nlink != 1 || pathStat.Mode&0o7777 != 0o600 || pathStat.Size != candidate.size {
+		return fmt.Errorf("lifecycle log %q path changed before prune", candidate.path)
+	}
+	if err := unix.Unlinkat(logsFD, candidate.name, 0); err != nil {
+		return err
+	}
+	if err := unix.Fsync(logsFD); err != nil {
+		return err
+	}
+	return nil
+}
