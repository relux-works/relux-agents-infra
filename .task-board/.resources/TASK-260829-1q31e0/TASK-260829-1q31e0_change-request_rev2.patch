+func TestPiLifecycleLogPruningDeterministicallyPreservesActiveNewestAndForeignFiles(t *testing.T) {
+	state := newPiLifecycleLogTestState(t)
+	now := time.Date(2026, time.August, 29, 12, 0, 0, 0, time.UTC)
+	policy := PiLifecycleLogRetention{MaxCount: 3, MaxBytes: 1 << 20, MaxAgeSeconds: 30 * 24 * 60 * 60}
+	active := writePiLifecycleLogFixture(t, state, now.Add(-60*24*time.Hour), 1, 20, 0o600)
+	newest := writePiLifecycleLogFixture(t, state, now.Add(-time.Hour), 2, 20, 0o600)
+	secondNewest := writePiLifecycleLogFixture(t, state, now.Add(-2*time.Hour), 3, 20, 0o600)
+	thirdNewest := writePiLifecycleLogFixture(t, state, now.Add(-3*time.Hour), 4, 20, 0o600)
+	oldest := writePiLifecycleLogFixture(t, state, now.Add(-4*time.Hour), 5, 20, 0o600)
+	foreign := filepath.Join(state.LogsDir, "operator-notes.jsonl")
+	if err := os.WriteFile(foreign, []byte("foreign"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	wrongMode := writePiLifecycleLogFixture(t, state, now.Add(-5*time.Hour), 6, 20, 0o644)
+	symlink := filepath.Join(state.LogsDir, piLifecycleLogFixtureName(now.Add(-6*time.Hour), 7))
+	if err := os.Symlink(foreign, symlink); err != nil {
+		t.Fatal(err)
+	}
+
+	result, err := prunePiLifecycleLogs(state, policy, now, active, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.PrunedCount != 2 || result.PrunedBytes != 40 {
+		t.Fatalf("pruned=%d/%d want=2/40", result.PrunedCount, result.PrunedBytes)
+	}
+	for _, path := range []string{active, newest, secondNewest, foreign, wrongMode, symlink} {
+		if _, err := os.Lstat(path); err != nil {
+			t.Fatalf("preserved path %s: %v", filepath.Base(path), err)
+		}
+	}
+	for _, path := range []string{thirdNewest, oldest} {
+		if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("pruned path %s still present: %v", filepath.Base(path), err)
+		}
+	}
+	if got := result.After; !got.WithinPolicy || got.ManagedCount != 3 || got.ActiveCount != 1 || got.ExpiredCount != 0 || got.ForeignCount != 3 {
+		t.Fatalf("post-prune footprint=%#v", got)
+	}
+}
