@@ -0,0 +1,45 @@
+package infra
+
+import "time"
+
+// PiLifecycleLogFootprint is a read-only observation of launcher-owned logs.
+// Foreign entries are reported separately and never count as policy-owned
+// bytes or files.
+type PiLifecycleLogFootprint struct {
+	Observation                 string     `json:"observation"`
+	ParticipatingDirectoryCount int        `json:"participating_directory_count"`
+	DirectoryCount              int        `json:"directory_count"`
+	DirectoryBytes              int64      `json:"directory_bytes"`
+	ManagedCount                int        `json:"managed_count"`
+	ManagedBytes                int64      `json:"managed_bytes"`
+	ExpiredCount                int        `json:"expired_count"`
+	ForeignCount                int        `json:"foreign_count"`
+	ForeignBytes                int64      `json:"foreign_bytes"`
+	ActiveCount                 int        `json:"active_count"`
+	OldestStarted               *time.Time `json:"oldest_started_at,omitempty"`
+	NewestStarted               *time.Time `json:"newest_started_at,omitempty"`
+	WithinPolicy                bool       `json:"within_policy"`
+	Error                       string     `json:"error,omitempty"`
+}
+
+// PiLifecycleLogStatus is emitted by non-launching plans and managed-run
+// reports so soak evidence can bind configured limits to observed footprint.
+type PiLifecycleLogStatus struct {
+	Directory      string                  `json:"directory"`
+	PolicySource   string                  `json:"policy_source,omitempty"`
+	Retention      PiLifecycleLogRetention `json:"retention"`
+	Footprint      PiLifecycleLogFootprint `json:"footprint"`
+	PrunedCount    int                     `json:"pruned_count"`
+	PrunedBytes    int64                   `json:"pruned_bytes"`
+	DroppedRecords int                     `json:"dropped_records"`
+	LastError      string                  `json:"last_error,omitempty"`
+}
+
+func newPiLifecycleLogStatus(paths PiStatePaths, policy PiLifecycleLogRetention, source string, now time.Time, activePath string) PiLifecycleLogStatus {
+	return PiLifecycleLogStatus{
+		Directory:    piLifecycleProfileRootPath(paths),
+		PolicySource: source,
+		Retention:    policy,
+		Footprint:    observePiLifecycleLogFootprint(paths, policy, now, activePath),
+	}
+}
