+				_ = json.NewEncoder(writer).Encode(tc.body)
+			}))
+			defer server.Close()
+			observation, err := observeSharedRuntimeProviderResources(context.Background(), server.Client(), server.URL+"/v1", "Qwen-test", policy)
+			if tc.wantErr {
