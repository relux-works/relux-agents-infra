diff --git a/tools/mlx-swift-runtime-prototype/Tests/MLXSwiftRuntimeContractTests/RuntimeStreamDeltaTests.swift b/tools/mlx-swift-runtime-prototype/Tests/MLXSwiftRuntimeContractTests/RuntimeStreamDeltaTests.swift
new file mode 100644
index 0000000..f6a3fd0
--- /dev/null
+++ b/tools/mlx-swift-runtime-prototype/Tests/MLXSwiftRuntimeContractTests/RuntimeStreamDeltaTests.swift
@@ -0,0 +1,78 @@
+import Foundation
+import Testing
+
+@testable import MLXSwiftRuntimeContract
+
+@Suite("Cross-runtime stream timing boundary")
+struct RuntimeStreamDeltaTests {
+    @Test(
+        "both deployed reasoning spellings carry generated text",
+        arguments: ["reasoning", "reasoning_content"])
+    func bothReasoningSpellingsCarryGeneratedText(field: String) {
+        let reading = RuntimeStreamDelta.read([field: "thinking"])
+        #expect(reading.content.isEmpty)
+        #expect(reading.reasoning == "thinking")
+        #expect(reading.generatedText == "thinking")
+        #expect(reading.carriesGeneratedText)
+    }
+
+    @Test("content and both reasoning spellings share one event definition")
+    func allGeneratedFieldsShareOneEventDefinition() {
+        let reading = RuntimeStreamDelta.read([
+            "content": "answer",
+            "reasoning": "first",
+            "reasoning_content": "second",
+        ])
+        #expect(reading.content == "answer")
+        #expect(reading.reasoning == "firstsecond")
+        #expect(reading.generatedText == "answerfirstsecond")
+    }
+
+    @Test("absent, empty, and malformed fields do not mint a timing event")
+    func noGeneratedTextMeansNoTimingEvent() {
+        for delta: [String: Any] in [
+            [:],
+            ["content": "", "reasoning": "", "reasoning_content": ""],
+            ["content": NSNull(), "reasoning": 7, "reasoning_content": false],
+        ] {
+            #expect(!RuntimeStreamDelta.read(delta).carriesGeneratedText)
+        }
+    }
+}
+
+@Suite("Runtime memory accounting")
+struct RuntimeMemoryAccountingTests {
+    @Test("the shipped llama-server path refuses Mach footprint scoring")
+    func llamaServerIsUnmeasurable() {
+        let reading = RuntimeMemoryAccounting.forExecutable(
+            "/opt/homebrew/bin/llama-server",
+            modelPath: "/models/qwen.gguf")
+        #expect(reading == .unmeasurableMMapLoadedWeights)
+        #expect(!reading.isMeasurable)
+        #expect(reading.limitation(runtime: "llama-cpp")?.contains("favour this runtime") == true)
+    }
+
+    @Test("a renamed runtime cannot score a GGUF through Mach footprint")
+    func ggufClassificationDoesNotDependOnTheExecutableName() {
+        #expect(
+            RuntimeMemoryAccounting.forExecutable(
+                "/tmp/runtime-wrapper", modelPath: "/models/mlx-weights",
+                launchArgv: ["--model", "/models/Qwen.Q8_0.GGUF"])
+                == .unmeasurableMMapLoadedWeights)
+    }
+
+    @Test("the classifier is not widened to unrelated names")
+    func lookalikesKeepTheirMeasuredSource() {
+        for path in [
+            "/opt/homebrew/bin/llama-server-next",
+            "/tmp/not-llama-server",
+            "/Users/test/bin/mlx_lm-relux.server",
+            "/Applications/mlx-swift-runtime-prototype",
+        ] {
+            #expect(
+                RuntimeMemoryAccounting.forExecutable(
+                    path, modelPath: "/models/mlx-weights") == .machPhysicalFootprint,
+                "unexpected classification for \(path)")
+        }
+    }
+}
