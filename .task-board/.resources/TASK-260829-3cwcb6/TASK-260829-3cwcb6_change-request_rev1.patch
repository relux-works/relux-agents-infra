index 0000000..d3a9008
--- /dev/null
+++ b/tools/mlx-swift-runtime-prototype/Sources/MLXSwiftRuntimeContract/RuntimeMemoryAccounting.swift
@@ -0,0 +1,44 @@
+import Foundation
+
+/// The memory quantity the benchmark can honestly report for a runtime.
+///
+/// Mach physical footprint is useful for the MLX runtimes, whose weights are
+/// anonymous allocations. It is not a process-resident-size measurement and
+/// excludes the clean file-backed pages `llama-server` uses for mmap-loaded
+/// GGUF weights. Reporting that number for llama.cpp would therefore score a
+/// known underestimate as if it described the model.
+public enum RuntimeMemoryAccounting: String, Codable, Equatable, Sendable {
+    case machPhysicalFootprint = "mach-physical-footprint"
+    case unmeasurableMMapLoadedWeights = "unmeasurable-mmap-loaded-weights"
+
+    /// Classify the executable the reviewed launcher profile names.
+    ///
+    /// Exact basename matching is deliberate. This closes the shipped
+    /// `/opt/homebrew/bin/llama-server` path without guessing that unrelated
+    /// executables with "llama" somewhere in their name share its allocator.
+    public static func forExecutable(
+        _ path: String, modelPath: String? = nil, launchArgv: [String] = []
+    ) -> RuntimeMemoryAccounting {
+        let isLlamaServer = URL(fileURLWithPath: path).lastPathComponent == "llama-server"
+        let modelIsGGUF =
+            modelPath.map {
+                URL(fileURLWithPath: $0).pathExtension.lowercased() == "gguf"
+            } ?? false
+        let launchCarriesGGUF = launchArgv.contains {
+            URL(fileURLWithPath: $0).pathExtension.lowercased() == "gguf"
+        }
+        return isLlamaServer || modelIsGGUF || launchCarriesGGUF
+            ? .unmeasurableMMapLoadedWeights : .machPhysicalFootprint
+    }
+
+    public var isMeasurable: Bool { self == .machPhysicalFootprint }
+
+    /// A record-level limitation with its directional consequence.
+    public func limitation(runtime: String) -> String? {
+        guard self == .unmeasurableMMapLoadedWeights else { return nil }
+        return
+            "memory for runtime \(runtime) is unmeasurable by Mach ri_phys_footprint: "
+            + "clean resident mmap-loaded weights are excluded; scoring the old reading would "
+            + "favour this runtime, so every footprint metric is reported unmeasured and refused"
+    }
+}
