+func TestSharedRuntimeLogWriterRefusesAbsentNumericPolicy(t *testing.T) {
+	clock := &fakeSharedLogClock{now: time.Date(2026, 8, 29, 12, 0, 0, 0, time.UTC)}
+	for _, test := range []struct {
