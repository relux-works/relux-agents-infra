new file mode 100644
index 0000000..ceca110
--- /dev/null
+++ b/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BenchmarkMemorySamplerProbe.swift
@@ -0,0 +1,46 @@
+import Darwin
+import Foundation
+import MLXSwiftRuntimeContract
+
+/// Weight-free production-entry fixture for the sampler's sub-cadence miss.
+/// The allocation lives for 150 ms, far below the bounded 5 s `vmmap` cadence.
+enum BenchmarkMemorySamplerProbe {
+    static let name = "benchmark-memory-sampler-probe"
+
+    static func run() -> Int32 {
+        let bytes = 128 * 1_024 * 1_024
+        let sampler = BenchmarkFootprintSampler(pid: Int(getpid()))
+        sampler.start()
+        sampler.beginWindow()
+        guard
+            let address = mmap(
+                nil, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0),
+            address != MAP_FAILED
+        else { return 2 }
+        memset(address, 0x5a, bytes)
+        usleep(150_000)
+        munmap(address, bytes)
+        usleep(150_000)
+        let peaks = sampler.capturePeaks()
+        sampler.stop()
+        guard let data = try? JSONEncoder().encode(peaks.window) else { return 2 }
+        FileHandle.standardOutput.write(data)
+        FileHandle.standardOutput.write(Data([0x0a]))
+        guard
+            let samples = peaks.window.rawSamples,
+            samples.count >= 3,
+            peaks.window.status == .measured,
+            peaks.window.validatedScoredBytes != nil,
+            peaks.window.readFailureCount == 0,
+            samples.allSatisfy({ $0.sampledAtUnixSeconds != nil }),
+            zip(samples, samples.dropFirst()).allSatisfy({ earlier, later in
+                later.sampledAtUnixSeconds! - earlier.sampledAtUnixSeconds!
+                    <= RuntimeMemoryAccounting.maximumPhysicalFootprintSampleGapSeconds
+            }),
+            let minimum = samples.map(\.machPhysicalFootprintBytes).min(),
+            let maximum = samples.map(\.machPhysicalFootprintBytes).max(),
+            maximum - minimum >= bytes / 2
+        else { return 1 }
+        return 0
+    }
+}
