diff --git a/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BenchmarkMemorySamplerProbe.swift b/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BenchmarkMemorySamplerProbe.swift
new file mode 100644
index 0000000..be4fbfc
--- /dev/null
+++ b/tools/mlx-swift-runtime-prototype/Sources/mlx-swift-runtime-prototype/BenchmarkMemorySamplerProbe.swift
@@ -0,0 +1,124 @@
+import Darwin
+import Foundation
+import MLXSwiftRuntimeContract
+
+/// Weight-free production-entry fixture for the sampler's sub-cadence miss.
+/// The allocation lives for 150 ms, far below the bounded 5 s `vmmap` cadence.
+enum BenchmarkMemorySamplerProbe {
+    static let name = "benchmark-memory-sampler-probe"
+
+    static func run() -> Int32 {
+        let bytes = 128 * 1_024 * 1_024
+        let sampler = BenchmarkFootprintSampler(pid: Int(getpid()))
+        sampler.start()
+        sampler.beginWindow()
+        guard
+            let address = mmap(
+                nil, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0),
+            address != MAP_FAILED
+        else { return 2 }
+        memset(address, 0x5a, bytes)
+        usleep(150_000)
+        munmap(address, bytes)
+        usleep(150_000)
+        let peaks = sampler.capturePeaks()
+        sampler.stop()
+        guard let data = try? JSONEncoder().encode(peaks.window) else { return 2 }
+        FileHandle.standardOutput.write(data)
+        FileHandle.standardOutput.write(Data([0x0a]))
+        guard
+            let samples = peaks.window.rawSamples,
+            samples.count >= 3,
+            peaks.window.status == .partial,
+            peaks.window.validatedScoredBytes == nil,
+            peaks.window.issues.contains("resident-mapped-file-sampling-gap"),
+            !peaks.window.issues.contains(where: { $0.hasPrefix("mach-physical-footprint") }),
+            samples.allSatisfy({ $0.machSampledAtUnixSeconds != nil }),
+            zip(samples, samples.dropFirst()).allSatisfy({ earlier, later in
+                later.machSampledAtUnixSeconds! - earlier.machSampledAtUnixSeconds!
+                    <= RuntimeMemoryAccounting.maximumPhysicalFootprintSampleGapSeconds
+            }),
+            let minimum = samples.map(\.machPhysicalFootprintBytes).min(),
+            let maximum = samples.map(\.machPhysicalFootprintBytes).max(),
+            maximum - minimum >= bytes / 2
+        else { return 1 }
+        return 0
+    }
+}
+
+/// File-backed counterpart to the anonymous fixture above. It proves the
+/// production entry either observes a transient mapped-file peak or refuses
+/// the window for inadequate mapped-file coverage; revision 2 instead scored a
+/// stale pre-transient vmmap value as fresh evidence.
+enum BenchmarkMappedFileSamplerProbe {
+    static let name = "benchmark-mapped-file-sampler-probe"
+
+    static func run() -> Int32 {
+        let bytes = 256 * 1_024 * 1_024
+        let path = FileManager.default.temporaryDirectory
+            .appendingPathComponent("benchmark-mapped-probe-\(UUID().uuidString)").path
+        let descriptor = open(path, O_RDWR | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR)
+        guard descriptor >= 0 else { return 2 }
+        defer {
+            close(descriptor)
+            unlink(path)
+        }
+        guard ftruncate(descriptor, off_t(bytes)) == 0 else { return 2 }
+        guard
+            let writable = mmap(nil, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0),
+            writable != MAP_FAILED
+        else { return 2 }
+        memset(writable, 0x5a, bytes)
+        guard msync(writable, bytes, MS_SYNC) == 0 else {
+            munmap(writable, bytes)
+            return 2
+        }
+        munmap(writable, bytes)
+
+        let sampler = BenchmarkFootprintSampler(pid: Int(getpid()))
+        sampler.start()
+        sampler.beginWindow()
+        guard
+            let mapped = mmap(nil, bytes, PROT_READ, MAP_PRIVATE, descriptor, 0),
+            mapped != MAP_FAILED
+        else { return 2 }
+        var checksum: UInt8 = 0
+        let readable = mapped.assumingMemoryBound(to: UInt8.self)
+        for offset in stride(from: 0, to: bytes, by: Int(getpagesize())) {
+            checksum ^= readable[offset]
+        }
+        guard case .measured(let direct) = residentMemorySample(pid: Int(getpid())) else {
+            munmap(mapped, bytes)
+            return 2
+        }
+        usleep(150_000)
+        munmap(mapped, bytes)
+        usleep(150_000)
+        let peak = sampler.capturePeaks().window
+        sampler.stop()
+
+        let encodedPeak = try? JSONEncoder().encode(peak)
+        let peakObject = encodedPeak.flatMap {
+            try? JSONSerialization.jsonObject(with: $0)
+        }
+        let output: [String: Any] = [
+            "checksum": Int(checksum),
+            "directMappedFileBytesUpperBound": direct.residentMappedFileBytesUpperBound,
+            "peak": peakObject ?? NSNull(),
+        ]
+        guard let data = try? JSONSerialization.data(withJSONObject: output) else { return 2 }
+        FileHandle.standardOutput.write(data)
+        FileHandle.standardOutput.write(Data([0x0a]))
+
+        guard direct.residentMappedFileBytesUpperBound >= bytes / 2 else { return 2 }
+        if peak.status == .measured {
+            return (peak.peakSample?.residentMappedFileBytesUpperBound ?? 0)
+                >= direct.residentMappedFileBytesUpperBound - bytes / 8 ? 0 : 1
+        }
+        let mappedCoverageRefused = peak.issues.contains {
+            $0 == "resident-mapped-file-sampling-gap"
+                || $0 == "resident-mapped-file-sampling-coverage-insufficient"
+        }
+        return peak.status == .partial && mappedCoverageRefused ? 0 : 1
+    }
+}
