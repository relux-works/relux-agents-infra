+	if err := validatePiLifecycleFile(fd, 0, true); err != nil {
+		file.Close()
+		return nil, piError("lifecycle_log_evidence_unknown", err)
+	}
+	for {
+		if err := syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB); err == nil {
+			return file, nil
