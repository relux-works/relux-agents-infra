+func assertExternalCILocalMirrorPolicyBlock(t *testing.T, path string, body []byte) {
+	t.Helper()
+	if err := validateExternalCILocalMirrorPolicyBlock(body); err != nil {
+		t.Fatalf("external-CI policy at %s: %v", path, err)
+	}
+}
+
+func validateExternalCILocalMirrorPolicyBlock(body []byte) error {
+	heading := []byte(externalCILocalMirrorPolicyHeading)
+	start := bytes.Index(body, heading)
+	if start < 0 {
+		return fmt.Errorf("missing policy heading %q", externalCILocalMirrorPolicyHeading)
+	}
+	if bytes.Contains(body[start+len(heading):], heading) {
+		return fmt.Errorf("duplicate policy heading %q", externalCILocalMirrorPolicyHeading)
+	}
+	remainder := body[start:]
+	end := bytes.Index(remainder, []byte("\n## "))
+	if end < 0 {
+		return fmt.Errorf("policy block %q has no following top-level section", externalCILocalMirrorPolicyHeading)
+	}
+	actual := bytes.TrimSuffix(remainder[:end], []byte("\n"))
+	if !bytes.Equal(actual, []byte(externalCILocalMirrorPolicyBlock)) {
+		return fmt.Errorf("policy block %q differs from the accepted revision-4 contract", externalCILocalMirrorPolicyHeading)
+	}
+	return nil
+}
