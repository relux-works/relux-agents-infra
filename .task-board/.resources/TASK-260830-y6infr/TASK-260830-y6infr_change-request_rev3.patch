+func TestPiTurnTranslatorRefusesMissingAuthoritativeMessageAndPostAgentTools(t *testing.T) {
+	missingAssistantMessage := `{"type":"session","version":3,"id":"fixture","timestamp":"2026-08-30T00:00:00Z","cwd":"/repo"}
