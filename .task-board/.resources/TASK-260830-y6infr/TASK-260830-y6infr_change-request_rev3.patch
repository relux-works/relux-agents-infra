+func TestPiTurnTranslatorClassPrecedence(t *testing.T) {
+	code, _ := classifyPiTurn(errors.New("child failed"), PiRunReport{Managed: true, CleanupConfirmed: false}, []byte(validPiTurnJSONL), false)
