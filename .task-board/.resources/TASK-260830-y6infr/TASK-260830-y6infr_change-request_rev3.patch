+		{"trailing non-whitespace bytes", "printf '%s' '" + okTurnDocument + "trailing'\nexit 0\n"},
+		{"unknown error code", "printf '%s' '" + refusalTurnDocument("pi_turn_invented_code") + "'\nexit 1\n"},
