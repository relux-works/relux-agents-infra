+			return nil, false, errors.New("short Linux directory record fields")
+		}
+		inode := binary.NativeEndian.Uint64(buffer[inoOffset : inoOffset+8])
+		offset := int64(binary.NativeEndian.Uint64(buffer[offsetOffset : offsetOffset+8]))
