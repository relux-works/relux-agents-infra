+	data, err := json.Marshal(piSessionLogRecord{Timestamp: piLifecycleNow().UTC().Format(time.RFC3339Nano), Event: "cap", Fields: map[string]any{"v": 1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	data = append(data, '\n')
+	next := log.record
