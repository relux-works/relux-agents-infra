+func directProviderYoloWrapperBody(launcher directProviderYoloLauncher, goos string) string {
+	targetName := canonicalTargetWrapperName(launcher.canonicalTarget, goos)
+	if strings.EqualFold(goos, "windows") {
+		return fmt.Sprintf("@echo off\r\nsetlocal\r\nset \"DIR=%%~dp0\"\r\nif not exist \"%%DIR%%%s\" (\r\n  echo %s: missing canonical provider target %%DIR%%%s 1^>^&2\r\n  exit /b 127\r\n)\r\n\"%%DIR%%%s\" -d %%*\r\nexit /b %%ERRORLEVEL%%\r\n", targetName, launcher.name, targetName, targetName)
+	}
+	return fmt.Sprintf(`#!/usr/bin/env sh
+set -eu
+DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+TARGET="$DIR/%s"
+if [ ! -f "$TARGET" ] || [ -L "$TARGET" ] || [ ! -x "$TARGET" ]; then
+  echo "%s: missing canonical provider target $TARGET" >&2
+  exit 127
+fi
+exec "$TARGET" -d "$@"
+`, targetName, launcher.name)
+}
