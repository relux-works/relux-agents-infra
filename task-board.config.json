{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "spawn": {
    "enabled": true,
    "max_parallel": 20,
    "ceilings": {
      "codex": {
        "model": "gpt-5.6-sol",
        "model_criterion": "less_or_equal",
        "reasoning_effort": "high"
      },
      "claude": {
        "model": "claude-opus-5",
        "model_criterion": "less_or_equal",
        "reasoning_effort": "high"
      }
    },
    "preferred_agentic_system": {
      "exclusive": "codex"
    },
    "worktree_isolation": {
      "validation": {
        "commands": [
          "cd tools/agents-infra && go test ./... -count=1",
          "cd tools/agents-infra && go vet ./..."
        ]
      }
    }
  },
  "version_control": {
    "confirm": true,
    "desired_commit_time": "backdated to previous day, after 20:00 MSK (evening) per owner policy"
  }
}
