{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "spawn": {
    "enabled": true,
    "max_parallel": 20,
    "ceilings": {
      "contract_version": "spawn-policy-v4",
      "codex": {
        "entries": [
          {
            "criterion": "equal",
            "model": "gpt-5.6-sol",
            "reasoning_effort": "high"
          }
        ],
        "resolution_model": "gpt-5.6-sol",
        "adjustment_confirmation": "none"
      },
      "claude": {
        "entries": [
          {
            "criterion": "equal",
            "model": "claude-opus-5",
            "reasoning_effort": "high"
          }
        ],
        "resolution_model": "claude-opus-5",
        "adjustment_confirmation": "none"
      }
    },
    "preferred_agentic_system": {
      "exclusive": "claude"
    },
    "worktree_isolation": {
      "validation": {
        "commands": [
          "cd tools/agents-infra && go test ./... -count=1",
          "cd tools/agents-infra && go vet ./..."
        ]
      }
    }
  },
  "version_control": {
    "confirm": true,
    "desired_commit_time": "backdated to previous day, after 20:00 MSK (evening) per owner policy"
  }
}
